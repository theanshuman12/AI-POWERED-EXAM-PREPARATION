# GEMINI_API_KEY: Required for optional Gemini AI concept explanations
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Application URL
APP_URL="http://localhost:3000"

# Server Port
PORT=3000

# Authentication
JWT_SECRET="ai-power-exam-prep-secure-jwt-secret-key-2025"

# Database Configuration (Optional MongoDB URI; falls back to embedded JSON storage)
MONGO_URI="mongodb://localhost:27017/aipowerexamprep"

# AI Service URL (FastAPI service address)
AI_SERVICE_URL="http://localhost:8000"

