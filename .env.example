# Optional server-side Gemini API key for AI explanations and hints.
GEMINI_API_KEY=

# Render sets PORT automatically; keep this empty locally unless overriding it.
PORT=

# Production runtime mode.
NODE_ENV=production

# Public application URL, used to restrict cross-origin requests when needed.
APP_URL=

# Secret used to sign and verify authentication tokens. Set a strong random value.
JWT_SECRET=

# Email of the one protected Super Admin account. Required in production.
SUPER_ADMIN_EMAIL=

# Initial password used only when bootstrapping the Super Admin account. Keep secret.
SUPER_ADMIN_PASSWORD=

# Optional MongoDB connection string. The application uses embedded JSON storage when unset.
MONGO_URI=

# Optional external FastAPI AI service URL. The built-in analyzer remains the fallback.
AI_SERVICE_URL=

